    "testing",
    "qase"
  ],
  "author": "Ernest Sosnovskyi",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^7.5.0",
    "playwright-qase-reporter": "^2.6.0"
  }
}