{
  "name": "playwright-ai-framework",
  "version": "1.0.0",
  "description": "Playwright E2E automation framework powered by AI Agents and Qase TMS integration",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "keywords": [
    "playwright",
    "ai",
    "automation",
